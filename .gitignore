.env
.env.*
!.env.example
*.pem

# ─── Tests ───────────────────────────────────────────────────────────────────
coverage/
test-results/
playwright-report/
blob-report/
tests/e2e/.state/
playwright/.cache/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*

# ─── OS and editor files ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ─── Local tooling ───────────────────────────────────────────────────────────
.claude/
