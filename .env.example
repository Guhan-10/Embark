# App
APP_URL=http://localhost:3000
# Company timezone: due dates, expiry, and the daily reminder run use it
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata
# When daily reminders run (cron, in the timezone above)
DAILY_JOBS_CRON=0 8 * * *

# Better Auth (generate the secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# PostgreSQL
POSTGRES_USER=embark
POSTGRES_PASSWORD=change-me
POSTGRES_DB=embark
POSTGRES_PORT=5434
DATABASE_URL=postgresql://embark:change-me@localhost:5434/embark

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# S3-compatible storage (RustFS; console at http://localhost:9001)
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_REGION=us-east-1
S3_ACCESS_KEY=embark
S3_SECRET_KEY=change-me
S3_BUCKET=embark-documents

# Email (Mailpit in development: inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Embark <no-reply@embark.local>"
