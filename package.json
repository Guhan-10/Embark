{
  "name": "embark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "department:set-hr": "tsx --import ./scripts/server-only-hook.mjs scripts/set-department-hr.ts",
    "worker": "node --import tsx --import ./scripts/server-only-hook.mjs lib/queue/worker.ts",
    "jobs:daily": "tsx --import ./scripts/server-only-hook.mjs scripts/run-daily-jobs.ts",
    "demo:seed": "tsx --import ./scripts/server-only-hook.mjs scripts/demo-data.ts",
    "demo:clean": "tsx --import ./scripts/server-only-hook.mjs scripts/demo-data.ts clean"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@hookform/resolvers": "^5.9.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "^1.7.11",
    "bullmq": "^6.3.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "file-type": "^22.2.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.7",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/nodemailer": "*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "postcss": "^8",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
